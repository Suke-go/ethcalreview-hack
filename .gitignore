# ========================================
# EthicalReviewHacker .gitignore
# ========================================

# Environment & Secrets
backend/.env
*.env
!.env.example
!backend/.env.example

# Generated outputs
backend/output/
backend/sessions/

# Sample documents (個人情報含む)
sample/01-*.docx
sample/01_*.xlsm
sample/*shimizu*
sample/*Shimizu*
sample/*清水*
sample/実験参加者リスト*.xlsx

# Keep consent templates
!sample/03_同意書(sample).docx
!sample/04_同意撤回書(sample).docx

# Settings with real info
settings.json
backend/settings.json
backend/lab_defaults.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env.local
*.egg-info/

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Knowledge base (Gemini)
.gemini/
