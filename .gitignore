# ========================================
# EthicalReviewHacker .gitignore
# ========================================

# Environment & Secrets
backend/.env
*.env
!.env.example
!backend/.env.example

# Generated outputs
backend/output/
backend/sessions/
output/
sessions/

# Sample documents (個人情報含む)
sample/01-*.docx
sample/01_*.xlsm
sample/*shimizu*
sample/*Shimizu*
sample/*清水*
sample/実験参加者リスト*.xlsx

# Keep consent templates
!sample/03_同意書(sample).docx
!sample/04_同意撤回書(sample).docx

# Settings with real info
settings.json
backend/settings.json
backend/lab_defaults.json
lab_defaults.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env.local
*.egg-info/

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Electron builds
dist-electron/
backend-dist/
*.exe
*.dmg
*.AppImage
*.snap

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Knowledge base (Gemini)
.gemini/


# ========================================
# Build artifacts (PyInstaller / Tauri / Cargo)
# ========================================
backend/dist/
backend/dist-onefile/
backend/build/
backend/build-onefile/
backend/pyinstaller*.log

src-tauri/target/
src-tauri/gen/
src-tauri/*.log
src-tauri/*.stdout.log
src-tauri/*.stderr.log

# Sidecar binaries (target-triple suffixed) - regenerated by CI
src-tauri/binaries/backend-*
!src-tauri/binaries/README.md
